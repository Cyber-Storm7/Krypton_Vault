<?xml version="1.0" encoding="utf-8"?>
<!-- Zero-Knowledge Offline Security: Disallow cloud extraction -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
